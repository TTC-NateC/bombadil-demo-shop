// specs/01 §4. Full schema, including fields inert until later slices
// (relatedIds — slice 3; imageUrl writes — slice 2). Later slices add no migrations.

generator client {
  provider      = "prisma-client-js"
  // debian-openssl-3.0.x for the node:20-slim runner (§10). Alpine/musl is
  // deliberately avoided: the musl engine mismatch is the most common
  // Next+Prisma container failure and surfaces only on someone else's machine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  priceCents  Int
  currency    String   @default("USD")
  category    String?
  imageUrl    String?
  active      Boolean  @default(true)
  relatedIds  String   @default("[]") // JSON array of productIds
  createdAt   DateTime @default(now())

  cartItems CartItem[]
}

model Coupon {
  id          String  @id @default(cuid())
  code        String  @unique // stored uppercase; input uppercased at apply time
  description String?
  type        String // CouponType — see §4.3. SQLite has no enum support.

  // value semantics depend on type:
  //  PERCENT       -> value = basis points off (1000 = 10%)
  //  FIXED         -> value = cents off
  //  FREE_SHIPPING -> value ignored
  value Int @default(0)

  targetType  String  @default("CART") // TargetType — see §4.3
  targetValue String? // category name or productId

  minSubtotalCents Int?
  maxDiscountCents Int?
  stackable        Boolean   @default(true)
  priority         Int       @default(100) // lower applies first
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int? // informational only in this demo
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // JSON array of applied coupon codes. Holds EXACTLY what applied on the last
  // pricing pass — everything else is pruned (§5.6).
  coupons String @default("[]")

  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  // Captured when the row is created. The engine reads this, never
  // Product.priceCents (§4.1).
  unitPriceCentsSnapshot Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  // Cascade is explicit: Prisma's default for a required relation is Restrict,
  // which would make DELETE /api/products/[id] throw P2003 (§4.2).
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}
