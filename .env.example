# specs/01 §10, specs/02 §2.2. Copy to .env for local development.
DATABASE_URL="file:/data/app.db"
STORE_CURRENCY="USD"
TAX_RATE_BPS="800"
TAX_ON_SHIPPING="false"
SHIPPING_FLAT_CENTS="599"
FREE_SHIPPING_THRESHOLD_CENTS="5000"

# REQUIRED. Ships empty on purpose: a .env.example exists to be copied, and a
# known default value here would mean the documented happy path yields a
# container where a publicly-known string grants bulk catalog deletion and
# arbitrary file writes. The container refuses to start in production if this is
# unset or "change-me".
ADMIN_API_KEY=""

UPLOAD_DIR="/data/uploads"
MAX_UPLOAD_BYTES="5242880"
